PROJECT_NAME=Nyaya Setu API
ENV=development
API_V1_STR=/api/v1
DATABASE_URL=postgresql+psycopg://nyaya:nyaya@db:5432/nyaya
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60

QDRANT_COLLECTION=nyaya_setu_chunks
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CONFIDENCE_THRESHOLD=0.5

LLM_PROVIDER=hf
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://api-inference.huggingface.co/models
HF_API_KEY=replace-with-huggingface-token
VISION_PROVIDER=hf
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=optional-gemini-fallback-key

WORKING_LANGUAGE=en
FASTTEXT_LANGID_MODEL=data/language_models/lid.176.ftz
BHASHINI_API_URL=
BHASHINI_API_KEY=
BHASHINI_TRANSLATE_URL=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_STT_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=
BHASHINI_TIMEOUT_SECONDS=60
EVIDENCE_MIN_CHUNKS=1
EVIDENCE_MIN_AGREEMENT=0
EVIDENCE_MIN_AUTHORITY=0
EVIDENCE_COVERAGE_MIN=0.2

