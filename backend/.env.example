# Nyaya Setu backend environment
# Copy to backend/.env. Values here are loaded even if you start the app from the repo root.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./nyaya_setu.db

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nyaya_setu_chunks

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INLEGALBERT_MODEL=law-ai/InLegalBERT
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

LLM_PROVIDER=hf
LLM_MODEL=Qwen/Qwen3.5-27B
HF_API_KEY=

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh

CONFIDENCE_THRESHOLD=0.5
