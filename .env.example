# ============================================================================
# BACKEND SETTINGS (FastAPI)
# ============================================================================
PROJECT_NAME=Nyaya Setu API
ENV=development
API_V1_STR=/api/v1
DATABASE_URL=postgresql+psycopg://nyaya:nyaya@localhost:5432/nyaya
SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# AI SETTINGS (Nyaya Setu AI Package)
# ============================================================================
# Qdrant (vector database) configuration
QDRANT_COLLECTION=nyaya_setu_chunks
QDRANT_URL=http://localhost:6333

# Embedding model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Cross-encoder model (HuggingFace)
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Generation
LLM_PROVIDER=hf
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://api-inference.huggingface.co/models
HF_API_KEY=your-huggingface-token-here
VISION_PROVIDER=hf
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Optional Gemini fallback
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Language and translation
WORKING_LANGUAGE=en
FASTTEXT_LANGID_MODEL=lid.176.ftz

# Bhashini (optional, for Indian language support)
BHASHINI_API_URL=https://api.bhashini.gov.in/
BHASHINI_API_KEY=your-bhashini-key-here
BHASHINI_TRANSLATE_URL=https://translate.bhashini.gov.in/
BHASHINI_TARGET_LANG=en

# Retrieval confidence threshold
CONFIDENCE_THRESHOLD=0.5
